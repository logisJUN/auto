# Bybit API credentials (from Bybit account -> API Management)
# Create a KEY WITH "Contract Trading" permission only. Do NOT enable withdrawal permission.
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# true = practice on Bybit testnet (fake money). Keep true until you trust the bot.
BYBIT_TESTNET=true

# Optional: broaden news coverage (https://newsapi.org, free tier). Leave blank to use RSS only.
NEWSAPI_KEY=

# Optional: get push notifications on your iPad via Telegram.
# 1) Message @BotFather on Telegram -> /newbot -> copy token
# 2) Message @userinfobot to get your numeric chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: daily performance-summary email (survives Render free-plan disk
# resets, unlike local log files). Example for Gmail: create an "App
# Password" at https://myaccount.google.com/apppasswords (needs 2FA enabled)
# and use that as EMAIL_SMTP_PASSWORD -- your normal Gmail password won't work.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional: token required to view the web dashboard (?token=...). Set something random.
DASHBOARD_TOKEN=changeme

# -- bot/aggressive_btc.py (separate, optional single-symbol strategy, currently SOXLUSDT) --
# Only needed if you run it. Create a Bybit TESTNET account (testnet.bybit.com,
# separate login from your real account) and an API key there -- your real
# BYBIT_API_KEY above will NOT authenticate against the testnet host. Leave
# both blank and aggressive_btc.py refuses to start rather than silently
# reusing your live key against testnet (or worse, misrouting). Going live
# (flipping TESTNET=False in bot/aggressive_btc.py) reuses BYBIT_API_KEY/
# SECRET above instead -- same real account as the main bot.
AGGRESSIVE_BTC_TESTNET_API_KEY=
AGGRESSIVE_BTC_TESTNET_API_SECRET=
# Set to "true" to actually start this strategy's loop at all (in render_app.py
# / bot.aggressive_btc.main) -- false/unset means it never runs, so deploying
# updated code alone can never start it by surprise.
AGGRESSIVE_BTC_ENABLED=false

